# Copy to .env.local for local development (git-ignored).
# The address of YOUR Cloudflare Worker. This is public, not a secret.
# The NVIDIA key never goes in this file, only into Cloudflare (`npx wrangler secret put NVIDIA_API_KEY`).
NEXT_PUBLIC_AI_ENDPOINT=https://wallet-ai.YOUR-SUBDOMAIN.workers.dev

# Only for GitHub Pages project sites (https://user.github.io/REPO): the repo name with a leading slash.
# NEXT_PUBLIC_BASE_PATH=/wallet-tracker
